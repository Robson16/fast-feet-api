# Application
PORT="3333"

# Database (PostGresSQL)
DATABASE_URL="postgresql://postgres:docker@localhost:5432/fast-feet?schema=public"

# APP_ADMIN_PASSWORD is used by prisma/seed.ts to provision the initial administrator.
# Keep its value secret and do not commit it.
APP_ADMIN_PASSWORD=""

# Auth (JWT)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""