# Application
PORT="3333"

# Database (PostGresSQL)
DATABASE_URL="postgresql://postgres:docker@localhost:5432/fast-feet?schema=public"

# APP_ADMIN_PASSWORD is used by prisma/seed.ts to provision the initial administrator.
# Keep its value secret and do not commit it.
APP_ADMIN_PASSWORD=""

# Auth (JWT)
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ACCESS_TOKEN_TTL_SECONDS="900"

# Upload (AWS / CloudFlare R2 / LocalStack)
CLOUDFLARE_ACCOUNT_ID="local"
AWS_BUCKET_NAME="fast-feet"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
# Optional: set to http://localhost:4566 when using LocalStack
AWS_ENDPOINT="http://localhost:4566"